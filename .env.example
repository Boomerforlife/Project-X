# ProjectX environment. Copy to `.env` (git-ignored). Never commit real values.
# Secrets are left blank. Defaults below run everything locally with no credentials and no network.
# Worker (production) secrets are set with `wrangler secret put`, not in this file (see docs/DEPLOYMENT.md).

# ---- General (all) ----
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=info                 # debug | info | warn | error

# ---- Database (api, ai, pxw) ----
DB_DRIVER=pglite               # pglite | postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres   # SECRET in prod: Supavisor txn pooler :6543
DB_POOL_MAX=1                  # 5 for real Postgres; 1 with `npm run db:serve` (single-connection pglite-server)
PGLITE_DATA_DIR=.local/pglite  # or memory://

# ---- Auth (api) ----
SUPABASE_URL=                  # https://<project-ref>.supabase.co (JWKS + issuer base)
SUPABASE_JWT_ISSUER=           # default: ${SUPABASE_URL}/auth/v1
AUTH_MODE=test                 # jwks | hs256 | test  (test is forbidden when APP_ENV=production)
SUPABASE_JWT_SECRET=           # SECRET, only for AUTH_MODE=hs256
TEST_JWT_SECRET=dev-only-test-jwt-secret-change-me   # dev/test only; used by `npm run token -w @projectx/api`

# ---- HTTP (api) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173   # comma list
ENABLE_API_DOCS=true           # true in dev, false in prod
PUBLIC_ASSETS_BASE_URL=http://localhost:8787/__local/public   # prod: https://assets.<domain>
FILES_BASE_URL=http://localhost:8787/api/v1/files             # prod: https://api.<domain>/api/v1/files

# ---- Storage (api, pxw) ----
STORAGE_DRIVER=local           # local | r2  (api: R2 bindings; pxw: S3 API)
LOCAL_STORAGE_DIR=.local/storage
SIGNING_SECRET=dev-only-signing-secret-change-me     # SECRET: HMAC for signed file URLs
IP_HASH_SECRET=dev-only-ip-hash-secret-change-me     # SECRET: HMAC for ip hashing

# ---- R2 (pxw, ops scripts, wrangler); keys live on the operator machine only ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=              # SECRET
R2_SECRET_ACCESS_KEY=          # SECRET
R2_BUCKET_SOURCE_DOCS=projectx-source-docs
R2_BUCKET_PUBLIC_ASSETS=projectx-public-assets
R2_BUCKET_USER_UPLOADS=projectx-user-uploads

# ---- Edge: cache + rate limit (api) ----
CACHE_PURGE_DRIVER=noop        # noop | workers | zone_api | both
CACHE_MODE=none                # workers | cache_api | none
CF_ZONE_ID=
CF_API_TOKEN_PURGE=            # SECRET, token scoped to Cache Purge only
WEB_REVALIDATE_URL=            # optional, e.g. http://localhost:3000/api/revalidate/ (web revalidation webhook)
WEB_REVALIDATE_SECRET=         # SECRET (>= 32 chars), must equal the web app's REVALIDATE_SECRET
RATE_LIMIT_DRIVER=memory       # memory | cloudflare | noop

# ---- AI (ai) ----
AI_PROVIDER=mock               # mock | gemini (auto-mock + warning if no key)
GEMINI_API_KEY=                # SECRET, server/operator only
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash   # re-verify model ids at deploy time
AI_DAILY_BUDGET_USD=1.00
AI_MAX_CALLS_PER_RUN=200
PYTHON_BIN=python
SYMPY_TIMEOUT_MS=5000

# ---- Python workers (pxw) ----
PXW_WORK_DIR=.local/work
PXW_JOB_STORE=file             # file | postgres
OCR_ENGINES=rapidocr,paddle,tesseract
OCR_MIN_CONFIDENCE=0.6

# ---- Web app (Next.js; deployed with OpenNext on Cloudflare, see docs/DEPLOYMENT.md section 5) ----
# NEXT_PUBLIC_* values are inlined at BUILD time: one build per environment (never reuse a staging build in production).
# On Workers Builds they must be set as *build* variables; for local `npm run deploy:web:*` export them in the shell.
# Also drives the Content-Security-Policy connect-src in next.config.ts (API + Supabase origins).
NEXT_PUBLIC_DATA_SOURCE=mock   # mock | api (api only takes effect when NEXT_PUBLIC_API_BASE_URL is also set)
NEXT_PUBLIC_API_BASE_URL=      # e.g. http://localhost:8787/api/v1 ; prod: https://api.<domain>/api/v1
API_BASE_URL=                  # server-only override for server components (optional); runtime var on the web Worker
NEXT_PUBLIC_AUTH_MODE=         # supabase | dev (dev = offline test tokens; never in production, /api/dev/token is 404 in builds anyway)
NEXT_PUBLIC_SUPABASE_URL=      # https://<project-ref>.supabase.co ; public by design
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... ; public by design; never a secret / service-role key
DEV_TEST_JWT_SECRET=           # server-only, dev; must equal the API TEST_JWT_SECRET. Never set on a deployed Worker
REVALIDATE_SECRET=             # SECRET (>= 32 chars), runtime secret on the web Worker (`wrangler secret put REVALIDATE_SECRET --env <env>`);
                               # must equal the API WEB_REVALIDATE_SECRET. The API POSTs here via WEB_REVALIDATE_URL (above)
NEXT_PUBLIC_FEATURE_PAPERS=off        # off | demo
NEXT_PUBLIC_FEATURE_LEADERBOARD=off   # off | demo
NEXT_PUBLIC_ALLOW_INDEXING=           # true to allow indexing (API mode only)
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # prod: https://<domain> (canonical URLs, metadataBase)

# ---- Deploy tooling (operator machine / CI only; NEVER commit, never set on a Worker) ----
CLOUDFLARE_ACCOUNT_ID=         # wrangler / opennextjs-cloudflare deploy
CLOUDFLARE_API_TOKEN=          # SECRET, Workers/R2/D1 edit scope for deploys (distinct from CF_API_TOKEN_PURGE)
NEXT_INC_CACHE_R2_PREFIX=      # optional, OpenNext R2 incremental-cache key prefix (default "incremental-cache")
SUPABASE_ACCESS_TOKEN=         # SECRET, Supabase CLI (`supabase login` alternative)
SUPABASE_DB_PASSWORD=          # SECRET, Supabase CLI `db push`
