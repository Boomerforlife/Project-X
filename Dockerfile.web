# Web (Next.js) container for Google Cloud Run. Build context = repo root.
# Build:  gcloud builds submit . --config cloudbuild.web.yaml --ignore-file=.gcloudignore.web --substitutions=...
# NEXT_PUBLIC_* values are inlined at build time: one image per environment.
FROM node:22-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages ./packages
RUN npm ci --ignore-scripts --legacy-peer-deps
COPY . .
ARG NEXT_PUBLIC_DATA_SOURCE=api
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_AUTH_MODE=supabase
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ALLOW_INDEXING=false
ARG NEXT_PUBLIC_FEATURE_PAPERS=off
ARG NEXT_PUBLIC_FEATURE_LEADERBOARD=off
ARG NEXT_PUBLIC_AUTH_GOOGLE=off
ARG NEXT_PUBLIC_ADS=off
ARG NEXT_PUBLIC_ADSENSE_CLIENT
ARG NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY
ARG NEXT_PUBLIC_ADSENSE_SLOT_INFEED
ARG NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY
ARG NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX
ARG NEXT_PUBLIC_GAM_REWARDED_UNIT
ARG NEXT_PUBLIC_ADS_NPA=on
ENV NEXT_PUBLIC_DATA_SOURCE=$NEXT_PUBLIC_DATA_SOURCE NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL NEXT_PUBLIC_AUTH_MODE=$NEXT_PUBLIC_AUTH_MODE \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_ALLOW_INDEXING=$NEXT_PUBLIC_ALLOW_INDEXING \
    NEXT_PUBLIC_FEATURE_PAPERS=$NEXT_PUBLIC_FEATURE_PAPERS NEXT_PUBLIC_FEATURE_LEADERBOARD=$NEXT_PUBLIC_FEATURE_LEADERBOARD NEXT_PUBLIC_AUTH_GOOGLE=$NEXT_PUBLIC_AUTH_GOOGLE     NEXT_PUBLIC_ADS=$NEXT_PUBLIC_ADS NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT     NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=$NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY NEXT_PUBLIC_ADSENSE_SLOT_INFEED=$NEXT_PUBLIC_ADSENSE_SLOT_INFEED     NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=$NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX=$NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX     NEXT_PUBLIC_GAM_REWARDED_UNIT=$NEXT_PUBLIC_GAM_REWARDED_UNIT NEXT_PUBLIC_ADS_NPA=$NEXT_PUBLIC_ADS_NPA
RUN npm run build:web && mkdir -p public  # the app has no public/ dir today; keep the COPY below working if one is added

# Runtime: Next standalone server only (no node_modules tree, no sources).
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 8080
USER node
CMD ["node", "server.js"]
