// ProjectX WEB Worker (Next.js via @opennextjs/cloudflare). The API Worker is configured separately in apps/api/wrangler.toml.
// Nothing here is deployed automatically. Every `wrangler deploy`, `wrangler secret put`, D1/R2 creation, route or DNS change
// REQUIRES APPROVAL (see docs/DEPLOYMENT.md section 5 and docs/CLOUD_SETUP_CHECKLIST.md).
// Local check without an account: `npm run preview:web` (workerd, local simulated bindings).
//
// Wrangler does NOT inherit bindings/vars into [env.*], so they are repeated on purpose.
// NO routes / custom domains are active. At deploy time (after approval) add under the env:
//   "routes": [{ "pattern": "<web-domain>", "custom_domain": true }]
// The web app must be on a Custom Domain (not a Route): the API Worker fetch()es it for revalidation (same-zone rule).
// database_id placeholders below are filled with the id printed by `wrangler d1 create` (REQUIRES APPROVAL).
// NEXT_PUBLIC_* values are NOT set here: they are inlined at BUILD time (set them in the shell / Workers Builds build vars).
// The secret REVALIDATE_SECRET is set with `wrangler secret put REVALIDATE_SECRET --env <env>` (not in this file).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projectx-web-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // ---- dev (top level; used by `npm run preview:web`) ----
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "projectx-web-dev" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "projectx-web-cache-dev" }],
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "projectx-web-tags-dev", "database_id": "<fill-at-deploy>" }
  ],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],

  "env": {
    "staging": {
      "name": "projectx-web-staging",
      "workers_dev": false,
      "observability": { "enabled": true },
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "projectx-web-staging" }],
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "projectx-web-cache-staging" }],
      "d1_databases": [
        { "binding": "NEXT_TAG_CACHE_D1", "database_name": "projectx-web-tags-staging", "database_id": "<fill-at-deploy>" }
      ],
      "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
      // "routes": [{ "pattern": "staging.<domain>", "custom_domain": true }]   // add after approval
    },
    "production": {
      "name": "projectx-web",
      "workers_dev": false,
      "observability": { "enabled": true },
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "projectx-web" }],
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "projectx-web-cache" }],
      "d1_databases": [
        { "binding": "NEXT_TAG_CACHE_D1", "database_name": "projectx-web-tags", "database_id": "<fill-at-deploy>" }
      ],
      "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
      // "routes": [{ "pattern": "<domain>", "custom_domain": true }]   // add after approval
    }
  }
}
