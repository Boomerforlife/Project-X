{
  "name": "projectx",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:serve": "npm run serve -w @projectx/db",
    "db:migrate": "npm run migrate -w @projectx/db",
    "dev:api": "npm run dev -w @projectx/api",
    "openapi": "npm run openapi:generate -w @projectx/api",
    "ai": "npm run ai -w @projectx/ai --"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "tsx": "4.23.15",
    "@types/node": "26.6.6"
  }
}
