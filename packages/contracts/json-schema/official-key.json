{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "source_document_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "question_number": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "external_question_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_answer": {
      "type": "string",
      "maxLength": 200
    },
    "normalized_answer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "OPTION_LABELS"
            },
            "labels": {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              }
            }
          },
          "required": [
            "kind",
            "labels"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "EXTERNAL_OPTION_IDS"
            },
            "ids": {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          },
          "required": [
            "kind",
            "ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "NUMERIC"
            },
            "accepted_ranges": {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "string",
                    "maxLength": 20,
                    "pattern": "^-?\\d+(\\.\\d+)?$"
                  },
                  "max": {
                    "type": "string",
                    "maxLength": 20,
                    "pattern": "^-?\\d+(\\.\\d+)?$"
                  }
                },
                "required": [
                  "min",
                  "max"
                ]
              }
            }
          },
          "required": [
            "kind",
            "accepted_ranges"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "DROPPED"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "is_dropped": {
      "type": "boolean"
    }
  },
  "required": [
    "paper_id",
    "source_document_id",
    "question_number",
    "external_question_id",
    "raw_answer",
    "normalized_answer",
    "is_dropped"
  ],
  "$id": "https://projectx.local/schemas/official-key.json",
  "title": "official-key"
}
