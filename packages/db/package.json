{
  "name": "@projectx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./pglite": "./src/pglite.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "serve": "tsx src/cli/serve.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "gen:types": "tsx src/cli/gen-types.ts"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16"
  }
}
